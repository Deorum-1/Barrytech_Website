{
  "redirects": [
    {
      "source": "/webmail",
      "destination": "https://da36.host-ww.net/roundcube/",
      "permanent": false
    },
    {
      "source": "/webmail/",
      "destination": "https://da36.host-ww.net/roundcube/",
      "permanent": false
    },
    {
      "source": "/roundcube",
      "destination": "https://da36.host-ww.net/roundcube/",
      "permanent": false
    },
    {
      "source": "/roundcube/",
      "destination": "https://da36.host-ww.net/roundcube/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
